# Copy to .env and set real values before running docker compose up.
# Every variable below is mandatory: the manager refuses to start on the prod
# profile while the shipped default credentials are still in place.

POSTGRES_DB=orthrus
POSTGRES_USER=orthrus
POSTGRES_PASSWORD=

# Shared secret the workers present on the manager's /api/internal/** and the manager
# presents on the AI orchestrator's /api/**. Any value, as long as it is not
# "change-me-in-production".
ORTHRUS_MASTER_INTERNAL_TOKEN=

# Credentials for the built-in admin account used when no OIDC provider is configured.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=
